{
  "name": "yash-palace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Yash Palace website and owner dashboard on Cloudflare Workers and D1",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite build && wrangler d1 migrations apply yash-palace --local && wrangler dev --port 8787 --ip 127.0.0.1",
    "test": "node --test worker/",
    "deploy": "node scripts/deploy.js",
    "owner:setup": "node scripts/setup-owner.js",
    "backup": "wrangler d1 export yash-palace --remote --output yash-palace-backup.sql",
    "deploy:domain": "node scripts/deploy.js --with-domains"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
